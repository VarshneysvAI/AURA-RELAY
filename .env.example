# Mode: sandbox or live
MODE=sandbox

# Server
APP_HOST=127.0.0.1
APP_PORT=8000
BASE_URL=http://127.0.0.1:8000

# Browser
HEADLESS=false
SLOW_MO=250
SCREENSHOT_AFTER_EACH_ACTION=true
REDACT_SECRETS=true

# Anakin.io (Web Search & Anti-Block Scraping)
ANAKIN_API_KEY=your-anakin-api-key
ANAKIN_BASE_URL=https://api.anakin.io/v1

# NVIDIA AI NIM
NVIDIA_LLM_API_KEY=nvapi-your-llm-key
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

NVIDIA_TTS_API_KEY=nvapi-your-tts-key
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
NVIDIA_TTS_BASE_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize

# Email & OTP
EMAIL_PROVIDER=local
EMAIL_POLL_INTERVAL_SECONDS=1
EMAIL_TIMEOUT_SECONDS=30
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
